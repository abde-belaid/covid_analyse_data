# MinIO configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_HOST=localhost
MINIO_PORT=9000

# Spark configuration
SPARK_APP_NAME=CovidDataAnalysis

# Data source configuration
COVID_DATA_URL=https://raw.githubusercontent.com/owid/covid-19-data/master/public/data/owid-covid-data.csv
# COVID_DATA_FILE=data/bronze/owid-covid-data.csv  # Uncomment to load a local file instead of downloading
